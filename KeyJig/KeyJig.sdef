<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="KeyJig Terminology">

	<!--
	     KeyJig Suite — all custom commands, the SVG dimensions
	     record-type, and the application-class extensions that power the
	     Script Debugger Explorer tab.
	-->

	<suite
        name="KeyJig Suite"
        code="VcIm"
        description="Commands and types for automating KeyJig."
    >




		<!--
		     Application class — Cocoa Scripting serves name / frontmost /
		     version natively without any SDEF declaration.  Declaring them
		     here conflicts with the framework's built-in handlers and causes
		     errors, so we leave them out and only add our custom properties.
		-->
		<class
            name="application"
            code="capp"
            description="KeyJig's top-level scripting object."
        >
			<cocoa class="NSApplication" />

			<property
                name="SVG"
                code="SVGc"
                type="text"
                access="r"
                description="The currently loaded SVG content as text."
            >
				<cocoa key="scriptingSVG" />
			</property>

			<property
                name="SVG file path"
                code="SVGp"
                type="text"
                access="r"
                description="The file path of the currently loaded SVG."
            >
				<cocoa key="scriptingSVGFilePath" />
			</property>

			<property
                name="pixel width"
                code="SVGw"
                type="text"
                access="r"
                description="The width of the currently loaded SVG."
            >
				<cocoa key="scriptingSVGWidth" />
			</property>

			<property
                name="pixel height"
                code="SVGh"
                type="text"
                access="r"
                description="The height of the currently loaded SVG."
            >
				<cocoa key="scriptingSVGHeight" />
			</property>

			<property
                name="file size"
                code="SVGs"
                type="text"
                access="r"
                description="The file size of the currently loaded SVG as a formatted string (e.g. &quot;42.3 KB&quot;)."
            >
				<cocoa key="scriptingFileSize" />
			</property>

			<property
                name="SVG creator"
                code="SVGr"
                type="text"
                access="r"
                description="Creator metadata extracted from the currently loaded SVG."
            >
				<cocoa key="scriptingSVGCreator" />
			</property>

			<property
                name="document name"
                code="SVGd"
                type="text"
                access="r"
                description="The name of the currently loaded document without its file extension, or an empty string if nothing is loaded."
            >
				<cocoa key="scriptingDocumentName" />
			</property>

			<property
                name="result file path"
                code="RFPh"
                type="text"
                access="r"
                description="POSIX path of the most recently produced output file: the pulled Keynote PDF if one is loaded, otherwise the staged SVG bridge file. Empty string if nothing has been converted yet."
            >
				<cocoa key="scriptingResultFilePath" />
			</property>

		</class>


		<!-- ── Core SVG Operations ──────────────────────────────────── -->

		<command
            name="convert"
            code="VcImCnvt"
            description="Convert the loaded SVG to Keynote format and copy it to the clipboard."
        >
			<cocoa class="ConvertCommand" />
			<result type="boolean" description="True if conversion succeeded." />
		</command>

		<command
            name="clear"
            code="VcImCler"
            description="Clear the currently loaded SVG from memory."
        >
			<cocoa class="ClearCommand" />
			<result type="boolean" description="True if successful." />
		</command>


		<!-- ── File Operations ─────────────────────────────────────── -->

		<command
            name="load SVG file"
            code="VcImLdSV"
            description="Load an SVG file from the specified POSIX path."
        >
			<cocoa class="LoadSVGFileCommand" />
			<direct-parameter type="text" description="The POSIX path to the SVG file." />
			<result
                type="boolean"
                description="True if the file was loaded successfully."
            />
		</command>

		<command
            name="open file"
            code="VcImOpnF"
            description="Open the system file-picker dialog so the user can choose an SVG file."
        >
			<cocoa class="OpenFileCommand" />
			<result
                type="boolean"
                description="True — the dialog is shown asynchronously."
            />
		</command>


		<!-- ── Clipboard Operations ────────────────────────────────── -->

		<command
            name="check clipboard"
            code="VcImChCB"
            description="Check the clipboard for SVG content without modifying it."
        >
			<cocoa class="CheckClipboardCommand" />
			<result
                type="text"
                description="The SVG string if found, or an empty string."
            />
		</command>

		<command
            name="check for convertible"
            code="VcImChCV"
            description="Check whether the clipboard contains PDF or vector data convertible to SVG via Inkscape."
        >
			<cocoa class="CheckConvertibleCommand" />
			<result
                type="boolean"
                description="True if convertible vector data is present."
            />
		</command>

		<command
            name="convert clipboard"
            code="VcImCvCB"
            description="Convert PDF or vector clipboard data to SVG using Inkscape. Blocks until complete (up to 30 s)."
        >
			<cocoa class="ConvertClipboardCommand" />
			<result
                type="text"
                description="The resulting SVG string, or an empty string if conversion failed."
            />
		</command>


		<!-- ── Information Queries ──────────────────────────────────── -->

		<command
            name="get SVG"
            code="VcImGtSV"
            description="Return the currently loaded SVG as a text string."
        >
			<cocoa class="GetSVGCommand" />
			<result type="text" description="The current SVG string." />
		</command>

		<command
            name="get SVG file path"
            code="VcImGtFP"
            description="Return the POSIX file-system path of the loaded SVG."
        >
			<cocoa class="GetSVGFilePathCommand" />
			<result
                type="text"
                description="The POSIX file path, or an empty string if no file is loaded."
            />
		</command>



		<command
            name="get SVG dimensions"
            code="VcImGtDm"
            description="Return the width and height of the loaded SVG as a record."
        >
			<cocoa class="GetSVGDimensionsCommand" />
			<result
                type="record"
                description="A record with width and height text fields, e.g. {width:&quot;512&quot;, height:&quot;384&quot;}."
            />
		</command>

		<command
            name="get file size"
            code="VcImGtSz"
            description="Return the size of the loaded SVG as a human-readable string."
        >
			<cocoa class="GetFileSizeCommand" />
			<result
                type="text"
                description="Formatted size string, e.g. &quot;42.3 KB&quot;."
            />
		</command>

		<command
            name="get SVG creator"
            code="VcImGtCr"
            description="Return creator metadata extracted from the loaded SVG."
        >
			<cocoa class="GetSVGCreatorCommand" />
			<result
                type="text"
                description="The creator string if found, or an empty string."
            />
		</command>


		<!-- ── Window Management ───────────────────────────────────── -->

		<command
            name="show main window"
            code="VcImShMW"
            description="Bring the main application window to the front."
        >
			<cocoa class="ShowMainWindowCommand" />
			<result type="boolean" description="Always true." />
		</command>

		<command
            name="show popover"
            code="VcImShPo"
            description="Show the menu-bar popover."
        >
			<cocoa class="ShowPopoverCommand" />
			<result type="boolean" description="Always true." />
		</command>

		<command
            name="new floating window"
            code="VcImNwFW"
            description="Open a new floating viewer window."
        >
			<cocoa class="NewFloatingWindowCommand" />
			<result type="boolean" description="Always true." />
		</command>


		<!-- ── Help and Info ───────────────────────────────────────── -->

		<command name="show about" code="VcImAbut" description="Show the About dialog.">
			<cocoa class="ShowAboutCommand" />
			<result type="boolean" description="Always true." />
		</command>

		<command
            name="show help"
            code="VcImHelp"
            description="Show the help documentation."
        >
			<cocoa class="ShowHelpCommand" />
			<result type="boolean" description="Always true." />
		</command>

	</suite>

</dictionary>
