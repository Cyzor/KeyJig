/* ── Help window ────────────────────────────────────────────────────── */
"dialog.help.title" = "Ayuda";
"help.section.import.title" = "Importar SVG";
"help.section.import.body" = "• Arrastra un archivo SVG o usa Archivo > Abrir archivo SVG… (⌘O).\n• Copia una ilustración en Illustrator, Affinity o Inkscape (⌘C) — KeyJig lo detecta automáticamente.\n• Con Inkscape instalado, KeyJig también abre archivos PDF y .ai.\n• Mantén ⌥ o ⇧ al arrastrar la vista previa para exportar PDF en lugar de SVG — cuando la fuente y el destino lo admiten.";
"help.section.history.title" = "Historial y deshacer";
"help.section.history.body" = "• ⌘Z / ⇧⌘Z deshace y rehace limpiezas del canvas; ⌘[ / ⌘] navega por los gráficos cargados recientemente.";
"help.section.keynote.title" = "Enviar a Keynote";
"help.section.keynote.body" = "• Copiar para Keynote (⌘K) — pega en Keynote (⌘V), luego Formato > Formas y líneas > Separar para editar los trayectos.\n• Insertar SVG en Keynote (⌘D) lo coloca directamente en la diapositiva actual.";
"help.section.pull.title" = "Convertir Keynote a PDF";
"help.section.pull.body" = "• Convertir portapapeles de Keynote (⌘E) — copia primero tu selección en Keynote (⌘C) para un resultado vectorial preciso.\n• Convertir diapositiva de Keynote a PDF (⌘R) exporta la diapositiva actual completa.\n• Arrastra la vista previa a Affinity, Illustrator, Figma u otra app.";
"help.section.setup.title" = "Permisos y dependencias";
"help.section.setup.body" = "• ⌘D necesita permiso de accesibilidad — Configuración del Sistema ▸ Privacidad y seguridad ▸ Accesibilidad.\n• PDF y .ai requieren Inkscape — inkscape.org o brew install inkscape.\n• Ghostscript y MuPDF (opcionales) mejoran la calidad del recorte de PDF.";

