/* ── Help window ────────────────────────────────────────────────────── */
"dialog.help.title" = "Hilfe";
"help.section.import.title" = "SVG importieren";
"help.section.import.body" = "• SVG-Datei ziehen oder Ablage > SVG-Datei öffnen… (⌘O) verwenden.\n• Grafik in Illustrator, Affinity oder Inkscape kopieren (⌘C) – KeyJig erkennt sie automatisch.\n• Mit installiertem Inkscape öffnet KeyJig auch PDF- und .ai-Dateien.\n• ⌥ oder ⇧ beim Ziehen der Vorschau gedrückt halten, um PDF statt SVG zu exportieren – wenn Quelle und Ziel es unterstützen.";
"help.section.history.title" = "Verlauf & Widerrufen";
"help.section.history.body" = "• ⌘Z / ⇧⌘Z macht Canvas-Löschungen rückgängig und wiederholt sie; ⌘[ / ⌘] durchsucht zuletzt geladene Grafiken.";
"help.section.keynote.title" = "An Keynote senden";
"help.section.keynote.body" = "• Für Keynote kopieren (⌘K) — in Keynote einsetzen (⌘V), dann Format > Formen und Linien > Aufteilen zum Bearbeiten.\n• SVG in Keynote einfügen (⌘D) platziert es direkt auf die aktuelle Folie.";
"help.section.pull.title" = "Keynote als PDF konvertieren";
"help.section.pull.body" = "• Keynote-Zwischenablage konvertieren (⌘E) — Auswahl zuerst in Keynote kopieren (⌘C) für ein präzises Vektor-Ergebnis.\n• Keynote-Folie als PDF konvertieren (⌘R) exportiert die gesamte aktuelle Folie.\n• Vorschau in Affinity, Illustrator, Figma oder eine andere App ziehen.";
"help.section.setup.title" = "Berechtigungen & Abhängigkeiten";
"help.section.setup.body" = "• ⌘D benötigt Bedienungshilfenzugriff — Systemeinstellungen ▸ Datenschutz & Sicherheit ▸ Bedienungshilfen.\n• PDF- und .ai-Dateien erfordern Inkscape — inkscape.org oder brew install inkscape.\n• Ghostscript und MuPDF (optional) verbessern die PDF-Zuschneidequalität.";

